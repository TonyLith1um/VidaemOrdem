rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserData(data, userId) {
      return data is map &&
        data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('themeColor' in data) || (data.themeColor is string && data.themeColor.size() <= 64)) &&
        (!('fontFamily' in data) || (data.fontFamily is string && data.fontFamily.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserData(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserData(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
