{
  "name": "vida-em-ordem",
  "version": "1.0.0",
  "description": "Organize todos os setores da vida: ciclo, hábitos, estudos, treino, alimentação, compras, agenda e diário.",
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/firebase-service.js --bundle --minify --outfile=firebase-bundle.js",
    "build": "esbuild src/firebase-service.js --bundle --minify --outfile=firebase-bundle.js",
    "lint": "node -c app.js && node -c server.js",
    "dev": "npm run bundle && node server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase": "^12.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
